{
  "title": "Optimum Gateway (hardened exporter)",
  "uid": "optimum-hardened",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    { "type": "stat", "title": "Gateway Up", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "optimum_gateway_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] }, "overrides": [] } },
    { "type": "stat", "title": "Last Block Age", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "optimum_gateway_last_block_age_sec", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "type": "stat", "title": "mump2p Peers", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "optimum_gateway_peers_connected", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] } },
    { "type": "stat", "title": "Uptime", "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "optimum_gateway_uptime_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] } },
    { "type": "timeseries", "title": "Telemetry fetch errors /s", "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [{ "expr": "rate(optimum_gateway_api_errors_total[5m])", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] } }
  ]
}