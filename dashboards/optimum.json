{
  "title": "Optimum Gateway (native)",
  "uid": "optimum-native",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 38,
  "panels": [
    {
      "type": "stat", "title": "Gateway Up",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"optimum-health-blackbox\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["last"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "noValue": "—", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Last Block Age",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "optimum_last_block_age_seconds", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "—", "color": { "mode": "thresholds" },
        "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "—", "color": "gray" } } }, { "type": "special", "options": { "match": "null", "result": { "text": "—", "color": "gray" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 60 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "mump2p Peers",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "optimum_mump2p_peers", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "noValue": "—", "color": { "mode": "thresholds" },
        "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "—", "color": "gray" } } }, { "type": "special", "options": { "match": "null", "result": { "text": "—", "color": "gray" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 3 } ] } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "Uptime",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "optimum_uptime_seconds", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "unit": "s", "noValue": "—", "color": { "mode": "thresholds" },
        "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "—", "color": "gray" } } }, { "type": "special", "options": { "match": "null", "result": { "text": "—", "color": "gray" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "green", "value": 0 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries", "title": "Health probe duration",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_duration_seconds{job=\"optimum-health-blackbox\"}", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "type": "stat", "title": "CL Peers",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "optimum_cl_peers", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }],
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["last"] }, "textMode": "auto" },
      "fieldConfig": { "defaults": { "noValue": "—", "color": { "mode": "thresholds" },
        "mappings": [ { "type": "special", "options": { "match": "nan", "result": { "text": "—", "color": "gray" } } }, { "type": "special", "options": { "match": "null", "result": { "text": "—", "color": "gray" } } } ],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "gray", "value": null }, { "color": "red", "value": 0 }, { "color": "green", "value": 1 } ] } }, "overrides": [] }
    }
  ]
}